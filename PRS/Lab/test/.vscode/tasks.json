{
  "version": "2.0.0",
  "options": {
    "env": { "PATH": "/usr/lib64/openmpi/bin:${env:PATH}" }
  },
  "tasks": [
    {
      "label": "MPI: build",
      "type": "shell",
      "command": "mpicc",
      "args": [
        "-Wall",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-lm"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MPI: run",
      "type": "shell",
      "command": "mpirun",
      "args": [
        "--oversubscribe",
        "-np",
        "${input:np}",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "dependsOn": "MPI: build",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "np",
      "type": "promptString",
      "description": "Broj procesa",
      "default": "4"
    }
  ]
}
